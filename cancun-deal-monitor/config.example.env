# Copia a config.env y completa. No subas config.env al git.

# Destinatario de alertas
ALERT_TO=aristides20@gmail.com
ALERT_FROM=noreply@wfitness.cl

# SMTP del servidor WFitness (usa el mismo que el CRM si ya envía mails)
SMTP_HOST=mail.wfitness.cl
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true

# Umbrales (CLP por persona, ida y vuelta)
THRESHOLD_GOOD=500000
THRESHOLD_GREAT=430000
THRESHOLD_PACKAGE=950000
THRESHOLD_DIRECT=650000

# Cada cuántas horas el cron debería correr (solo documentación; el cron real lo define crontab)
CHECK_INTERVAL_HOURS=3

# Ventanas de fechas a incluir en el mail (ida|vuelta|etiqueta; ...)
SEARCH_WINDOWS=2026-03-07|2026-03-20|prioridad marzo;2026-03-12|2026-03-19|marzo mid;2026-03-23|2026-03-31|marzo late;2026-02-28|2026-03-07|puente feb-mar

# Opcional: Amadeus (gratis en sandbox) — https://developers.amadeus.com
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# Ruta absoluta en el servidor donde guardar estado
STATE_PATH=/var/www/cancun-deal-monitor/data/state.json
